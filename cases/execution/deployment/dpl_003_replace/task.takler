#!/bin/bash
set -eu
export TAKLER_HOST="{{ TAKLER_HOST }}"
export TAKLER_PORT="{{ TAKLER_PORT }}"
export TAKLER_NAME="{{ TAKLER_NAME }}"
export TAKLER_ATTEMPT_ID="{{ TAKLER_ATTEMPT_ID }}"
export TAKLER_PASS="{{ TAKLER_PASS }}"
timeout --foreground 6s takler-client-py init --task-id "$$" --node-path "$TAKLER_NAME"
cd "{{ SCENARIO_DATA }}"
timeout --foreground 45s bash -c 'until test -f stop || test -f "release-$1"; do sleep 0.2; done' _ "{{ VERSION }}"
if test -f stop; then exit 0; fi
printf 'DPL003_OK %s\n' "{{ VERSION }}"
timeout --foreground 6s takler-client-py complete --node-path "$TAKLER_NAME"
